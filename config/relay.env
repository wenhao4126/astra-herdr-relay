# Astra Herdr Relay v0.5.0
ASTRA_RELAY_MAX_REWORKS=2
ASTRA_RELAY_MAX_ACTIVE_AGENTS=8
ASTRA_RELAY_POLL_SECONDS=2
ASTRA_JEV_SENSOR_MIN_INTERVAL=15
TYPESAFE_MODEL=jev-latest
TYPESAFE_TIMEOUT_SECONDS=15
# Optional: pin the Herdr workspace where agent tabs are created.
# ASTRA_HERDR_WORKSPACE_ID=w6
# 多个 Herdr 会话并存时，明确指定用户正在查看的会话。
# ASTRA_HERDR_SESSION=relay-v0.50
# 模型由 Astra 在 spawn --model 或 start-review-pair 中显式指定；Relay 不保存通用默认模型。
# 启动代理后仅当 Herdr 焦点仍在新标签时恢复启动前焦点。
# Do not let daemon reconciliation race Herdr agent startup.
ASTRA_RELAY_STARTUP_GRACE_SECONDS=45
# 最终审查门默认关闭，旧版 Jev Reviewer 与运行中 Sensor 保持原行为。
ASTRA_RELAY_FINAL_REVIEW_ENABLED=0
ASTRA_RELAY_OCR_COMMAND=ocr
# OCR 只接受独立 Git 根目录；上层 Obsidian 大仓库会被安全拒绝。
ASTRA_RELAY_OCR_TIMEOUT_SECONDS=300
# 最终审查次数超限时交回 Astra，不再调用 OCR。
ASTRA_RELAY_FINAL_REVIEW_MAX_REWORKS=2
